# opera — deployment / data config. `cp .env.example .env`, then fill in every <placeholder> and /path/to value.
# Every launcher loads this file (src/opera_env.py load_dotenv; the SFT shell scripts `set -a; . ./.env; set +a`).
# Behavioural knobs (turn caps, efforts, critic policy) are CLI flags / configs, NEVER env. Secrets, hostnames and
# personal paths live ONLY here: .env is gitignored, nothing below is read from any tracked file.
# OPERA_ROOT is optional — every script derives the repo root from its own location.
# OPERA_ROOT=/path/to/opera

# ── model relay (gpt-5.6 / claude-* as critic or agent; presets in configs/policy-models.yaml + critic-models.yaml) ──
MODEL_RELAY_BASE_URL=https://<relay-host>            # OpenAI-compatible relay; the presets add /v1 (chat) or /v1/responses
MODEL_RELAY_API_KEY=<relay api key>                  # its key (read at call time; RELAY_API_KEY is an accepted alias)

# ── self-hosted vLLM endpoints (one per agent preset; each http://<host>:<port>/v1; VLLM_API_KEY is sent to all) ──
QWEN35_9B_BASE_URL=http://<host>:<port>/v1           # preset qwen35-9b  (Qwen3.5-9B)
QWEN38_27B_BASE_URL=http://<host>:<port>/v1          # preset qwen38-27b (Qwen3.8-27B)
MUSE_GLIMMER_30B_BASE_URL=http://<host>:<port>/v1    # preset muse-glimmer-30b
DEEPSEEK_V4_FLASH_BASE_URL=http://<host>:<port>/v1   # preset deepseek-v4-flash (DeepSeek-V4-Flash-0731)
SFT_CRITIC_BASE_URL=http://<host>:<port>/v1          # preset sft-critic: a checkpoint served by src/sft/pipeline/serve_checkpoint.sh
VLLM_API_KEY=dummy                                   # the self-hosted routers are unauthenticated; any string
VLLM_BASE_URL=http://<host>:<port>/v1                # generic fallback used when a preset-specific *_BASE_URL is unset

# ── benchmarks: task caches and datasets ──
SWEBENCH_PRO_CACHE=/path/to/swebench-pro-cache       # SWE-bench Pro harbor task dirs (src/launch.py swebench-pro)
SWEBENCH_PRO_PARQUET=/path/to/swebench-pro.parquet   # the dataset parquet (or snapshot dir); needed by --selection smoke
# xrlenv cluster control plane (see vendor/xrlenv/.env.example)
XRLENV_GRPC_HOST=<grpc-host>
XRLENV_GRPC_PORT=50051
XRLENV_CONSUMER_TOKEN=<consumer token from xrlenv/.env>
# DeepSWE / tb21 / swe-rebench: read-only shared task cache (deep-swe/ shard, 113 tasks, pinned corpus)
XRLENV_BENCHMARK_CACHE=/path/to/xrlenv_benchmark_cache

# ── SFT (src/sft/pipeline, src/sft/scripts, src/sft/runs/_logs) ──
SFT_BASE_MODEL=/path/to/Qwen3.5-9B                   # the base policy: trained on, served under LoRA adapters, drift reference
VLLM_VENV=/path/to/venv/vllm                         # the venv whose bin/ has vllm (+ ninja) for serve_checkpoint.sh